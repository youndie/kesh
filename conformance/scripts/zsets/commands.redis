# The sorted set commands the brief lists, their options, refusals and the wrong type — without ZSCAN.
# A sorted set's order is its own in both servers, so every line is exact — scores included, printed
# as Redis 7.2's d2string prints them.
FLUSHALL
ZADD z 1 b 1 a
ZRANGE z 0 -1
ZRANGE z 0 -1 WITHSCORES
TYPE z
ZCARD z
ZADD board 10 alice 30 carol 20 bob 40 dave 5 eve
ZREVRANGE board 0 2 WITHSCORES
ZREVRANGE board 0 -1
ZRANGE board 1 3
ZRANGE board -2 -1 WITHSCORES
ZRANGE board 3 1
ZRANGE board 10 20
ZRANGE board 0 -1 REV
ZRANGE board 0 1 REV WITHSCORES
ZRANK board carol
ZREVRANK board carol
ZRANK board nobody
ZRANK nokey a
ZRANK board carol WITHSCORE
ZREVRANK board carol withscore
ZRANK board nobody WITHSCORE
ZRANK nokey a WITHSCORE
ZRANK board carol WITHSCORES
ZRANK board carol WITHSCORE x
ZSCORE board bob
ZSCORE board nobody
ZSCORE nokey a
ZMSCORE board bob nobody eve
ZMSCORE nokey a b
ZCOUNT board 10 30
ZCOUNT board (10 30
ZCOUNT board 10 (30
ZCOUNT board -inf +inf
ZCOUNT board (30 (30
ZCOUNT board 30 10
ZCOUNT board x 10
ZCOUNT board 10 x
ZCOUNT nokey 0 1
ZCOUNT nokey x 1
ZRANGE board 10 30 BYSCORE
ZRANGE board (10 30 BYSCORE WITHSCORES
ZRANGE board 30 10 BYSCORE REV
ZRANGE board (30 10 BYSCORE REV WITHSCORES
ZRANGE board -inf +inf BYSCORE LIMIT 1 2
ZRANGE board -inf +inf BYSCORE LIMIT -1 2
ZRANGE board -inf +inf BYSCORE LIMIT 1 -1
ZRANGE board -inf +inf BYSCORE LIMIT 0 0
ZRANGE board -inf +inf BYSCORE LIMIT 5 1
ZRANGE board -inf +inf BYSCORE LIMIT 10 1
ZRANGE board +inf -inf BYSCORE REV LIMIT 1 2 WITHSCORES
ZRANGE board "" 10 BYSCORE
ZRANGE board " 10" 20 BYSCORE
ZRANGE board "10 " 20 BYSCORE
ZRANGE board ( 10 BYSCORE
ZRANGE board 1e400 inf BYSCORE
ZRANGE board -1e400 5 BYSCORE
ZRANGE board nan 5 BYSCORE
ZRANGE board 0 -1 LIMIT 0 1
ZRANGE board a b BYLEX WITHSCORES
ZRANGE board 0 -1 BYSCORE BYLEX
ZRANGE board 0 -1 REV REV
ZRANGE board 0 -1 FOO
ZRANGE board 0 -1 LIMIT 1
ZRANGE board 0 1 BYSCORE LIMIT x 1
ZRANGE board x 1
ZRANGE board 0 x
ZREVRANGE board 0 -1 REV
ZREVRANGE board 0 -1 BYSCORE
ZREVRANGE board 0 -1 LIMIT 0 1
ZREVRANGE board 0 1 WITHSCORES
ZRANGE nokey 0 -1
ZRANGE nokey 0 1 BYSCORE
ZRANGE nokey x 1
ZADD lex 0 alpha 0 bravo 0 charlie 0 delta 0 echo
ZADD lex 0 "" 0 "\x00" 0 "\xff" 0 Alpha 0 alph
ZRANGE lex 0 -1
ZRANGE lex [bravo [delta BYLEX
ZRANGE lex (bravo (delta BYLEX
ZRANGE lex - + BYLEX
ZRANGE lex + - BYLEX
ZRANGE lex + - BYLEX REV
ZRANGE lex [delta [bravo BYLEX REV
ZRANGE lex - + BYLEX LIMIT 2 3
ZRANGE lex [b [c BYLEX
ZRANGE lex (a +  BYLEX
ZRANGE lex bravo delta BYLEX
ZRANGE lex [a ++ BYLEX
ZRANGE lex -- + BYLEX
ZRANGE lex "" + BYLEX
ZRANGE lex [ + BYLEX
ZRANGE lex ( + BYLEX
ZADD fmt 1.5 f0 0.1 f1 1e-7 f2 1.5e-7 f3 1e20 f4 5e18 f5 123456789012345680000 f6 -0 f7 2.5e-5 f8 1e-6 f9 3.3333333333333335 f10 1e300 f11 -1.5e300 f12 0.30000000000000004 f13 inf f14 -inf f15 1e21 f16 4611686018427387904 f17 4611686018427387903 f18 9007199254740993 f19 0.000123456789 f20 1e-310 f21 12345.678 f22 -7 f23 100 f24 1e2 f25 0.5e1 f26 +2 f27 .5 f28 5. f29
ZRANGE fmt 0 -1 WITHSCORES
ZSCORE fmt f7
ZMSCORE fmt f0 f1 f2 f3 f4
ZADD bad 1e400 x
ZADD bad 1e-400 x
ZADD bad nan x
ZADD bad " 1" x
ZADD bad "1 " x
ZADD bad "" x
EXISTS bad
ZADD o 5 m
ZADD o NX 1 m 2 n
ZSCORE o m
ZADD o XX 3 m 4 x
ZSCORE o m
ZSCORE o x
ZADD o GT 2 m
ZADD o GT CH 9 m
ZADD o LT CH 9 m 1 new
ZADD o CH 9 m 10 n
ZRANGE o 0 -1 WITHSCORES
ZADD o NX XX 1 m
ZADD o GT LT 1 m
ZADD o NX GT 1 m
ZADD o INCR 1 m 2 n
ZADD o 1
ZADD o 1 m 2
ZADD o NX
ZADD o x m
ZADD o 1 m x n
ZADD o CH
ZADD o incr 5 m
ZADD o INCR NX 5 m
ZADD o INCR XX 5 absent
ZADD o INCR GT -100 m
ZADD o INCR LT -100 m
ZADD nokey XX 1 m
ZADD nokey XX INCR 1 m
EXISTS nokey
ZINCRBY o 2.5 m
ZINCRBY o 1 fresh
ZINCRBY o x m
ZINCRBY o inf inf
ZINCRBY o -inf inf
ZSCORE o inf
ZINCRBY o 1 m 2
ZADD eq 0 a
ZADD eq -0 a
ZSCORE eq a
ZADD eq2 -0 a
ZSCORE eq2 a
ZADD eq2 0 a
ZSCORE eq2 a
ZADD eq2 CH 0 a
ZREM o m nobody
ZREM o nobody
ZREM nokey a
ZCARD o
ZADD p 1 a 2 b 3 c 4 d
ZPOPMIN p
ZPOPMAX p
ZPOPMIN p 0
ZPOPMIN p -1
ZPOPMIN p x
ZPOPMIN p 1 2
ZPOPMAX p 10
EXISTS p
ZPOPMIN nokey
ZPOPMIN nokey 3
ZPOPMAX nokey 0
ZADD r 1 a 2 b 3 c 4 d 5 e
ZREMRANGEBYSCORE r (1 3
ZRANGE r 0 -1
ZREMRANGEBYSCORE r x 1
ZREMRANGEBYSCORE r 10 20
ZREMRANGEBYRANK r 0 0
ZRANGE r 0 -1
ZREMRANGEBYRANK r x 1
ZREMRANGEBYRANK r 5 10
ZREMRANGEBYRANK r 0 -1
EXISTS r
ZREMRANGEBYSCORE nokey 0 1
ZREMRANGEBYRANK nokey 0 1
ZREMRANGEBYRANK nokey x 1
ZADD last 1 a
ZREM last a
EXISTS last
ZADD last2 1 a
ZREMRANGEBYSCORE last2 -inf +inf
EXISTS last2
SET s x
ZADD s 1 a
ZINCRBY s 1 a
ZREM s a
ZCARD s
ZSCORE s a
ZMSCORE s a
ZRANK s a
ZREVRANK s a WITHSCORE
ZCOUNT s 0 1
ZCOUNT s x 1
ZRANGE s 0 -1
ZRANGE s x 1
ZREVRANGE s 0 1
ZREMRANGEBYSCORE s 0 1
ZREMRANGEBYRANK s 0 1
ZPOPMIN s
ZPOPMAX s 1
ZADD s x a
ZADD s XX 1 a
GET board
HGET board f
LLEN board
SCARD board
EXPIRE board 100
[shape] TTL board
RENAME board board2
ZRANGE board2 0 -1 WITHSCORES
ZADD
ZINCRBY o 1
ZREM o
ZCARD
ZSCORE o
ZMSCORE o
ZRANK o
ZCOUNT o 0
ZRANGE o 0
ZREVRANGE o 0
ZREMRANGEBYSCORE o 0
ZREMRANGEBYRANK o 0
ZPOPMIN
# Where Redis's listpack ends (128 members, 64 bytes); the order is the same on both sides of it.
ZADD big 0 m000 1 m001 2 m002 3 m003 4 m004 5 m005 6 m006 7 m007 8 m008 9 m009 10 m010 11 m011 12 m012 13 m013 14 m014 15 m015 16 m016 0 m017 1 m018 2 m019 3 m020 4 m021 5 m022 6 m023 7 m024 8 m025 9 m026 10 m027 11 m028 12 m029 13 m030 14 m031 15 m032 16 m033 0 m034 1 m035 2 m036 3 m037 4 m038 5 m039 6 m040 7 m041 8 m042 9 m043 10 m044 11 m045 12 m046 13 m047 14 m048 15 m049 16 m050 0 m051 1 m052 2 m053 3 m054 4 m055 5 m056 6 m057 7 m058 8 m059 9 m060 10 m061 11 m062 12 m063 13 m064 14 m065 15 m066 16 m067 0 m068 1 m069 2 m070 3 m071 4 m072 5 m073 6 m074 7 m075 8 m076 9 m077 10 m078 11 m079 12 m080 13 m081 14 m082 15 m083 16 m084 0 m085 1 m086 2 m087 3 m088 4 m089 5 m090 6 m091 7 m092 8 m093 9 m094 10 m095 11 m096 12 m097 13 m098 14 m099 15 m100 16 m101 0 m102 1 m103 2 m104 3 m105 4 m106 5 m107 6 m108 7 m109 8 m110 9 m111 10 m112 11 m113 12 m114 13 m115 14 m116 15 m117 16 m118 0 m119 1 m120 2 m121 3 m122 4 m123 5 m124 6 m125 7 m126 8 m127
ZRANGE big 0 -1 WITHSCORES
ZADD big 3 extra
ZRANGE big 0 -1 WITHSCORES
ZRANK big extra
ZREVRANK big extra
ZRANGE big 5 10 BYSCORE LIMIT 3 4 WITHSCORES
ZRANGE big 10 5 BYSCORE REV LIMIT 3 4
ZREMRANGEBYRANK big 10 100
ZRANGE big 0 -1 WITHSCORES
ZADD wide 1 wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww 2 vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
ZRANGE wide 0 -1 WITHSCORES
