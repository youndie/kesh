# MSET, MGET, APPEND, STRLEN, GETRANGE, SETRANGE.
FLUSHALL
MSET a 1 b 2 c 3
MGET a b c nokey
MSET a 1 b
MSETNX a 1 d 4
MSETNX d 4 e 5
MGET d e
APPEND a xyz
APPEND newk hello
GET a
STRLEN a
STRLEN nokey
SET s1 "This is a string"
GETRANGE s1 0 3
GETRANGE s1 -3 -1
GETRANGE s1 0 -1
GETRANGE s1 10 100
GETRANGE s1 5 2
GETRANGE s1 -1 -5
GETRANGE s1 -100 2
GETRANGE nokey 0 1
GETRANGE s1 x 1
SETRANGE s1 10 String
GET s1
SETRANGE s2 5 abc
GET s2
SETRANGE s1 -1 x
SETRANGE s1 0 ""
SETRANGE nokey3 3 ""
SETRANGE s1 x y
